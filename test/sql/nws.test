Albemarle	1

query I
SELECT count(*) FROM nws.main.zones('fire', state := 'VA');
----
1

query T
SELECT name FROM nws.main.office('LWX');
----
Sterling

query T
SELECT title FROM nws.main.briefing('LWX');
----
Cold weather briefing

query I
SELECT count(*) FROM nws.main.briefing('ZZZ');
----
0

query I
SELECT count(*) FROM nws.main.weather_stories('LWX');
----
1

query T
SELECT term FROM nws.main.glossary();
----
Frost

query TT
SELECT usgs_id, state FROM nws.main.gauge('RMDV2');
----
02037500	VA

query TIT
SELECT product, primary_value::INTEGER, secondary_unit FROM nws.main.stageflow('RMDV2') ORDER BY product;
----
forecast	8	kcfs
observed	6	kcfs

query I
SELECT secondary_value IS NULL FROM nws.main.stageflow('RMDV2', product := 'forecast');
----
1

query TIT
SELECT category, stage::INTEGER, flow_unit FROM nws.main.flood_thresholds('RMDV2') ORDER BY stage;
----
action	9	cfs
minor	12	cfs
moderate	15	cfs
major	22	cfs

query T
SELECT statement FROM nws.main.flood_impacts('RMDV2');
----
River stage sensor operating limit

query IT
SELECT old_datum, preliminary FROM nws.main.historic_crests('RMDV2');
----
1	R

statement error
SELECT * FROM nws.main.stageflow('RMDV2', product := 'fake');
----
<REGEX>:.*

query I
SELECT duration_hours::INTEGER FROM nws.main.parse_valid_time('2026-01-02T12:00:00Z/PT2H');
----
2

query II
SELECT t.id, p.duration_hours::INTEGER FROM (VALUES (1, '2026-01-02T12:00:00Z/PT2H'), (2,NULL), (3, '2026-01-02T12:00:00Z/P1D')) t(id, valid_time) LEFT JOIN LATERAL nws.main.parse_valid_time(t.valid_time) p ON true ORDER BY t.id;
----
1	2
2	NULL
3	24

statement error
SELECT * FROM nws.main.alerts(area := 'CY');
----
pagination cycle

statement error
SELECT * FROM nws.main.alerts(area := 'XF');
----
outside the configured API root

statement error
SELECT * FROM nws.main.point('NaN'::DOUBLE, -78);
----
Invalid non-finite

statement error
SELECT * FROM nws.main.parse_valid_time('2026-01-02T12:00:00/PT2H');
----
interval start must have a timezone
