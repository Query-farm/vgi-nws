# name: test/sql/products.test
# description: GIS discovery, hazards and image sampling
# group: [nws]
require vgi

require-env NWS_WORKER

statement ok
ATTACH 'nws' (TYPE vgi, LOCATION '{NWS_WORKER}');

# products-discovery
query I
SELECT count(DISTINCT server)=4 AND count(*)=count(DISTINCT product_id) AND count(*) FILTER (WHERE service_type='FeatureServer')=0 FROM nws.main.map_products();
----
1

# products-alternates
query I
SELECT count(*)=1 FROM nws.main.map_products(server:='vector',folder:='outlooks',include_alternates:=true) WHERE service_type='FeatureServer';
----
1

# products-layers
query I
SELECT count(*)=2 AND min(layer_id)=99 AND max(layer_id)=100 AND min(reader)='map_features' FROM nws.main.map_layers('tropical:tropical/NHC_tropical_weather_summary/MapServer');
----
1

# products-fields
query I
SELECT count(*)=1 AND min(field_name)='OBJECTID' FROM nws.main.map_fields('tropical:tropical/NHC_tropical_weather_summary/MapServer',layer_id:=99) WHERE field_type='esriFieldTypeOID';
----
1

# products-map_features
query I
SELECT count(*)=3 AND sum(object_id)=6 AND count(geometry_json)=3 AND bool_and(attributes_json LIKE '%Fixture%') FROM nws.main.map_features('tropical:tropical/NHC_tropical_weather_summary/MapServer',99,include_geometry:=true,page_size:=1);
----
1

# products-map_features_at
query I
SELECT count(*)=3 AND sum(object_id)=6 AND count(geometry_json)=3 AND bool_and(attributes_json LIKE '%Fixture%') FROM nws.main.map_features_at('tropical:tropical/NHC_tropical_weather_summary/MapServer',99,38,-78,include_geometry:=true,page_size:=1);
----
1

# products-feature-outside
query I
SELECT count(*)=0 FROM nws.main.map_features_at('tropical:tropical/NHC_tropical_weather_summary/MapServer',99,0,0);
----
1

# products-native-raster
query I
SELECT count(*)=1 AND min(raw_value)=50.8 AND count(unit)=0 AND min(layer_id)=604 FROM nws.main.map_raster_at('raster:precip/rfc_gridded_ffg/MapServer',604,38,-78);
----
1

# products-image-pages
query I
SELECT count(*)=23 AND count(raw_value)=22 AND count(*) FILTER (WHERE raw_value=0)=1 AND count(DISTINCT raster_id)=23 FROM nws.main.map_image_at('raster:air_quality/ndgd_apm25_hr01/ImageServer',38,-78,page_size:=2);
----
1

# products-image-times
query I
SELECT count(*)=2 AND min(raster_id)=102 AND max(raster_id)=103 AND count(raw_value)=1 AND max(raw_value)=0 FROM nws.main.map_image_at('raster:air_quality/ndgd_apm25_hr01/ImageServer',38,-78,start_time:='2026-01-02T13:00:00Z',end_time:='2026-01-02T15:00:00Z');
----
1

# products-image-provenance
query I
SELECT bool_and(issued_at=TIMESTAMPTZ '2026-01-02 11:00:00+00' AND source_file_at=TIMESTAMPTZ '2026-01-02 11:59:59+00' AND ingested_at=TIMESTAMPTZ '2026-01-02 12:00:00+00' AND source_url LIKE '%getSamples?%' AND metadata_url LIKE '%/query?%' AND fetched_at IS NOT NULL) FROM nws.main.map_image_at('raster:air_quality/ndgd_apm25_hr01/ImageServer',38,-78);
----
1

# products-image-bands
query I
SELECT count(*)=92 AND count(DISTINCT band_index)=4 AND bool_and(raw_value=CASE band_index WHEN 1 THEN 7 WHEN 2 THEN 13 WHEN 3 THEN 29 ELSE 255 END) FROM nws.main.map_image_at('eventdriven:radar/radar_base_reflectivity_time/ImageServer',38,-78);
----
1

# products-ffg-1
query I
SELECT count(*)=1 AND min(hours)=1 AND min(threshold_mm)=50.8 AND min(threshold_inches)=2 AND min(raw_unit)='kg m-2' FROM nws.main.flash_flood_guidance_at(38,-78,hours:=1);
----
1

