# products-correlated
query I
SELECT count(*)=46 AND count(*) FILTER(WHERE a.value IS NULL)=2 FROM (VALUES (38.0,-78.0),(38.0,-78.0),(NULL,-78.0)) s(lat,lon), LATERAL nws.compat.air_quality_at(s.lat,s.lon,'{"product":"ozone_1h","page_size":2}') a;
----
1

