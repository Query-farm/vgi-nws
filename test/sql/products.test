SELECT count(*)=23 AND count(value)=22 AND min(value)=0 AND max(value)=12.5 AND count(unit)=0 AND bool_and(bias_corrected=false) FROM nws.main.air_quality_at(38,-78,product:='dust_column',bias_corrected:=false);
----
1

