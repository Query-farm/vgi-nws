# name: test/sql/land.test
# description: Soil moisture, rainfall anomalies, snow analysis and local storm reports
# group: [nws]
require vgi

require-env NWS_WORKER

statement ok
ATTACH 'nws' (TYPE vgi, LOCATION '{NWS_WORKER}');

# land-soil-values
query TRRTI
SELECT region,saturation_pct,raw_value,raw_unit,soil_depth_cm FROM nws.main.soil_moisture_at(38,-78);
----
conus	62.5	0.625	fraction	40

# land-soil-conus
query I
SELECT count(*) = 1 AND bool_and(region = 'conus' AND saturation_pct = 62.5) FROM nws.main.soil_moisture_at(38,-78);
----
1

# land-soil-alaska
query I
SELECT count(*) = 1 AND bool_and(region = 'alaska' AND saturation_pct = 80) FROM nws.main.soil_moisture_at(60,-150);
----
1

# land-soil-hawaii
query I
SELECT count(*) = 1 AND bool_and(region = 'hawaii' AND saturation_pct = 75) FROM nws.main.soil_moisture_at(20,-156);
----
1

# land-soil-puerto_rico
query I
SELECT count(*) = 1 AND bool_and(region = 'puerto_rico' AND saturation_pct = 90) FROM nws.main.soil_moisture_at(18,-66);
----
1

# land-soil-wrong-region
query I
SELECT count(*) = 0 FROM nws.main.soil_moisture_at(38,-78,region := 'hawaii');
----
1

# land-soil-times
query I
SELECT valid_at = TIMESTAMPTZ '2026-01-02 12:00:00+00' AND issued_at = TIMESTAMPTZ '2026-01-02 11:00:00+00' AND source_file_at = TIMESTAMPTZ '2026-01-02 12:00:01+00' AND ingested_at = TIMESTAMPTZ '2026-01-02 12:00:02+00' AND fetched_at IS NOT NULL AND source_url LIKE '%/identify?%' AND metadata_url LIKE '%/query?%' FROM nws.main.soil_moisture_at(38,-78);
----
1

# land-anomaly-values
query TRT
SELECT metric,value,unit FROM nws.main.precipitation_anomaly_at(38,-78) ORDER BY metric;
----
departure	-1.25	inches
normal	2	inches
percent_of_normal	37.5	percent

# land-anomaly-today
query I
SELECT count(*) = 3 AND count(DISTINCT metric) = 3 AND min(value) = -1.25 AND count(valid_at) = 0 AND count(issued_at) = 3 FROM nws.main.precipitation_anomaly_at(38,-78,period := 'today');
----
1

