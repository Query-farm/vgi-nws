# land-snow-values
query TRTI
SELECT variable,raw_value,raw_unit,value_mm FROM nws.main.snow_analysis_at(38,-105) ORDER BY variable;
----
depth	0.25	m	250
water_equivalent	45	kg m-2	45

# land-snow-times
query I
SELECT count(DISTINCT valid_at) = 2 AND min(valid_at) = TIMESTAMPTZ '2026-01-02 12:00:00+00' AND max(valid_at) = TIMESTAMPTZ '2026-01-02 13:00:00+00' FROM nws.main.snow_analysis_at(38,-105);
----
1

# land-snow-depth
query I
SELECT count(*) = 1 AND bool_and(variable = 'depth') FROM nws.main.snow_analysis_at(38,-105,variable := 'depth');
----
1

# land-snow-water_equivalent
query I
SELECT count(*) = 1 AND bool_and(variable = 'water_equivalent') FROM nws.main.snow_analysis_at(38,-105,variable := 'water_equivalent');
----
1

# land-soil_moisture_at-null
query I
SELECT count(*) = 0 FROM nws.main.soil_moisture_at(NULL,-78);
----
1

# land-soil_moisture_at-outside
query I
SELECT count(*) = 0 FROM nws.main.soil_moisture_at(38,78);
----
1

# land-soil_moisture_at-nodata
query I
SELECT count(*) = 1 AND count(saturation_pct) = 0 AND count(raster_id) = 1 FROM nws.main.soil_moisture_at(40,-78);
----
1

# land-soil_moisture_at-zero
query I
SELECT count(*) = 1 AND bool_and(saturation_pct = 0) FROM nws.main.soil_moisture_at(41,-78);
----
1

# land-soil_moisture_at-lateral
query II
SELECT s.id,count(p.raster_id) FROM (VALUES(1,38),(2,38),(3,NULL),(4,41)) s(id,lat) LEFT JOIN LATERAL nws.main.soil_moisture_at(s.lat,-78) p ON true GROUP BY s.id ORDER BY s.id;
----
1	1
2	1
3	0
4	1

# land-soil_moisture_at-batches
query I
SELECT count(*) = 40 AND count(DISTINCT s.id) = 40 FROM (SELECT i AS id, 38+(i%2) AS lat FROM range(40) t(i)) s, LATERAL nws.main.soil_moisture_at(s.lat,-78) p;
----
1

# land-precipitation_anomaly_at-null
query I
SELECT count(*) = 0 FROM nws.main.precipitation_anomaly_at(NULL,-78);
----
1

# land-precipitation_anomaly_at-outside
query I
SELECT count(*) = 0 FROM nws.main.precipitation_anomaly_at(38,78);
----
1

# land-precipitation_anomaly_at-nodata
query I
SELECT count(*) = 3 AND count(value) = 0 AND count(raster_id) = 3 FROM nws.main.precipitation_anomaly_at(40,-78);
----
1

# land-precipitation_anomaly_at-zero
query I
SELECT count(*) = 3 AND bool_and(value = 0) FROM nws.main.precipitation_anomaly_at(41,-78);
----
1

# land-precipitation_anomaly_at-lateral
query II
SELECT s.id,count(p.raster_id) FROM (VALUES(1,38),(2,38),(3,NULL),(4,41)) s(id,lat) LEFT JOIN LATERAL nws.main.precipitation_anomaly_at(s.lat,-78) p ON true GROUP BY s.id ORDER BY s.id;
----
1	3
2	3
3	0
4	3

# land-precipitation_anomaly_at-batches
query I
SELECT count(*) = 120 AND count(DISTINCT s.id) = 40 FROM (SELECT i AS id, 38+(i%2) AS lat FROM range(40) t(i)) s, LATERAL nws.main.precipitation_anomaly_at(s.lat,-78) p;
----
1

# land-snow_analysis_at-null
query I
SELECT count(*) = 0 FROM nws.main.snow_analysis_at(NULL,-78);
----
1

# land-snow_analysis_at-outside
query I
SELECT count(*) = 0 FROM nws.main.snow_analysis_at(38,78);
----
1

# land-snow_analysis_at-nodata
query I
SELECT count(*) = 2 AND count(value_mm) = 0 AND count(raster_id) = 2 FROM nws.main.snow_analysis_at(40,-78);
----
1

# land-snow_analysis_at-zero
query I
SELECT count(*) = 2 AND bool_and(value_mm = 0) FROM nws.main.snow_analysis_at(41,-78);
----
1

# land-snow_analysis_at-lateral
query II
SELECT s.id,count(p.raster_id) FROM (VALUES(1,38),(2,38),(3,NULL),(4,41)) s(id,lat) LEFT JOIN LATERAL nws.main.snow_analysis_at(s.lat,-78) p ON true GROUP BY s.id ORDER BY s.id;
----
1	2
2	2
3	0
4	2

# land-snow_analysis_at-batches
query I
SELECT count(*) = 80 AND count(DISTINCT s.id) = 40 FROM (SELECT i AS id, 38+(i%2) AS lat FROM range(40) t(i)) s, LATERAL nws.main.snow_analysis_at(s.lat,-78) p;
----
1

# land-compat-soil_moisture_at
query I
SELECT count(*) = 2 FROM (VALUES(38),(38),(NULL)) s(lat), LATERAL nws.compat.soil_moisture_at(s.lat,-78,'{"region":"conus"}') r;
----
1

# land-compat-precipitation_anomaly_at
query I
SELECT count(*) = 2 FROM (VALUES(38),(38),(NULL)) s(lat), LATERAL nws.compat.precipitation_anomaly_at(s.lat,-78,'{"period":"day7","metric":"departure"}') r;
----
1

# land-compat-snow_analysis_at
query I
SELECT count(*) = 2 FROM (VALUES(38),(38),(NULL)) s(lat), LATERAL nws.compat.snow_analysis_at(s.lat,-78,'{"variable":"water_equivalent"}') r;
----
1

# land-compat-storm_reports_near
query I
SELECT count(*) = 4 FROM (VALUES(38),(38),(NULL)) s(lat), LATERAL nws.compat.storm_reports_near(s.lat,-78,'{"radius_km":50,"event":"Hail","state":"VA","page_size":1}') r;
----
1

# land-reports-24
query I
SELECT count(*) = 8 AND count(DISTINCT object_id) = 8 AND count(geometry_json) = 0 AND count(distance_km) = 0 AND bool_and(lookback_hours = 24) FROM nws.main.storm_reports(lookback_hours := 24,page_size := 1);
----
1

# land-reports-48
query I
SELECT count(*) = 8 AND count(DISTINCT object_id) = 8 AND count(geometry_json) = 0 AND count(distance_km) = 0 AND bool_and(lookback_hours = 48) FROM nws.main.storm_reports(lookback_hours := 48,page_size := 1);
----
1

# land-reports-72
query I
SELECT count(*) = 8 AND count(DISTINCT object_id) = 8 AND count(geometry_json) = 0 AND count(distance_km) = 0 AND bool_and(lookback_hours = 72) FROM nws.main.storm_reports(lookback_hours := 72,page_size := 1);
----
1

# land-reports-magnitude
query ITRTT
SELECT object_id,event,magnitude,magnitude_text,unit FROM nws.main.storm_reports() WHERE object_id IN (1,2,5,6) ORDER BY object_id;
----
1	Hail	1.25	1.25	Inch
2	Thunderstorm Wind	NULL	E60	MPH
5	Rain	NULL	Trace	Inch
6	Rain	0	0	Inch

# land-reports-filter
query I
SELECT object_id FROM nws.main.storm_reports(state := 'VA',event := 'hAiL',page_size := 1) ORDER BY object_id;
----
1
3
8

# land-reports-empty
query I
SELECT count(*) = 0 FROM nws.main.storm_reports(event := 'missing',page_size := 1);
----
1

# land-reports-bbox
query I
SELECT count(*) = 5 AND count(geometry_json) = 5 FROM nws.main.storm_reports(bbox := '-79,37,-77,39',include_geometry := true);
----
1

# land-reports-time
query I
SELECT bool_and(reported_at = TIMESTAMPTZ '2026-01-02 12:00:00+00' AND source_file_at = TIMESTAMPTZ '2026-01-02 12:00:01+00' AND ingested_at = TIMESTAMPTZ '2026-01-02 12:00:02+00' AND fetched_at IS NOT NULL) FROM nws.main.storm_reports();
----
1

# land-reports-radius
query I
SELECT object_id FROM nws.main.storm_reports_near(38,-78,radius_km := 50,page_size := 1) ORDER BY object_id;
----
1
2
6
8

# land-reports-distance
query I
SELECT count(*) = 4 AND bool_and(distance_km >= 0 AND distance_km <= 50 AND latitude IS NOT NULL AND longitude IS NOT NULL) FROM nws.main.storm_reports_near(38,-78);
----
1

# land-reports-dateline
query I
SELECT object_id FROM nws.main.storm_reports_near(10,180) ORDER BY object_id;
----
4
5

# land-reports-dateline-bbox
query I
SELECT object_id FROM nws.main.storm_reports(bbox := '179,9,-179,11') ORDER BY object_id;
----
4
5

# land-reports-pole
query I
SELECT object_id FROM nws.main.storm_reports_near(90,0);
----
7

# land-reports-null
query I
SELECT count(*) = 0 FROM nws.main.storm_reports_near(NULL,-78);
----
1

# land-reports-lateral
query II
SELECT s.id,count(r.object_id) FROM (VALUES(1,38),(2,38),(3,NULL)) s(id,lat) LEFT JOIN LATERAL nws.main.storm_reports_near(s.lat,-78) r ON true GROUP BY s.id ORDER BY s.id;
----
1	4
2	4
3	0

# land-reports-batches
query I
SELECT count(*) = 160 AND count(DISTINCT s.id) = 40 FROM (SELECT i AS id,38+(i%2)*0.01 AS lat FROM range(40) t(i)) s, LATERAL nws.main.storm_reports_near(s.lat,-78) r;
----
1

