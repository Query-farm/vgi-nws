# extensions-winter-1-snow-4
query IIII
SELECT probability_min_pct, probability_max_pct, threshold_inches, category_code FROM nws.main.winter_precipitation(day := 1,hazard := 'snow',threshold_inches := 4) ORDER BY object_id;
----
10	39	4	1
40	69	4	2
70	100	4	3

