# extensions-winter-point
query TI
SELECT category, geometry_json IS NOT NULL FROM nws.main.winter_precipitation_at(38,-78, include_geometry := true,page_size := 1) ORDER BY object_id;
----
Slight (10-39%)	1
Moderate (40-69%)	1

# extensions-wssi-point
query T
SELECT impact FROM nws.main.winter_storm_severity_at(38,-78) ORDER BY object_id;
----
WINTER WEATHER AREA
MINOR

# extensions-winter-dateline
query II
SELECT count(*), min(object_id) FROM nws.main.winter_precipitation(bbox := '179,9,-179,11',page_size := 1);
----
1	3

# extensions-qpe-value
query RTII
SELECT precipitation, unit, issued_at = TIMESTAMPTZ '2026-01-02 12:00:00Z', source_url LIKE 'https://mapservices.weather.noaa.gov/raster/%' FROM nws.main.precipitation_observed_at(38,-78);
----
1.25	inches	1	1

# extensions-qpe-nodata-zero
query II
SELECT s.lat::DOUBLE, q.precipitation FROM (VALUES (40.0),(41.0)) s(lat), LATERAL nws.main.precipitation_observed_at(s.lat,-78) q ORDER BY s.lat;
----
40	NULL
41	0

# extensions-ratings
query RITTI
SELECT stage, flow, stage_unit, flow_unit, possibly_truncated FROM nws.main.rating_curve('RMDV2') ORDER BY stage;
----
-0.5	0	ft	cfs	0
0.01	2	ft	cfs	0
0.1	5	ft	cfs	0

# extensions-ratings-options
query RII
SELECT stage, flow, possibly_truncated FROM nws.main.rating_curve('RMDV2',sort := 'DESC',row_limit := 1,only_tenths := true);
----
0.1	5	1

# extensions-ratings-tenths
query II
SELECT count(*), bool_and(NOT possibly_truncated) FROM nws.main.rating_curve('RMDV2',only_tenths := true);
----
2	1

# extensions-reach
query TTII
SELECT reach_id, name, upstream_json LIKE '%23021906%', downstream_json LIKE '%23022058%' FROM nws.main.reach('23021904');
----
23021904	Deep Creek	1	1

# extensions-streamflow-analysis_assimilation
query IIIII
SELECT count(*), count(DISTINCT member), count(flow), min(flow), bool_and(flow_unit = 'ft³/s' AND reference_at = TIMESTAMPTZ '2026-01-02 12:00:00Z') FROM nws.main.reach_streamflow('23021904',series := 'analysis_assimilation');
----
2	1	1	100	1

