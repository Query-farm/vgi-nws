# extensions-wssi-day1-overall
query II
SELECT count(*), bool_and(issued_at = TIMESTAMPTZ '2025-12-31 23:16:00Z' AND valid_from = TIMESTAMPTZ '2026-01-01 00:00:00Z' AND valid_to = TIMESTAMPTZ '2026-01-04 00:00:00Z') FROM nws.main.winter_storm_severity(period := 'day1',component := 'overall');
----
3	1

