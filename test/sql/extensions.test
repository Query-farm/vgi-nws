# extensions-compat-winter_precipitation_at
query II
SELECT s.i, count(o.object_id) FROM (VALUES(1,38.0),(2,38.0),(3,NULL)) s(i,lat) LEFT JOIN LATERAL nws.compat.winter_precipitation_at(s.lat,-78,'{"hazard":"ice","threshold_inches":0.25,"page_size":1}') o ON true GROUP BY s.i ORDER BY s.i;
----
1	2
2	2
3	0

# extensions-compat-winter_storm_severity_at
query II
SELECT s.i, count(o.object_id) FROM (VALUES(1,38.0),(2,38.0),(3,NULL)) s(i,lat) LEFT JOIN LATERAL nws.compat.winter_storm_severity_at(s.lat,-78,'{"period":"day2","component":"ice","page_size":1}') o ON true GROUP BY s.i ORDER BY s.i;
----
1	2
2	2
3	0

# extensions-compat-climate_outlook_at
query II
SELECT s.i, count(o.object_id) FROM (VALUES(1,38.0),(2,38.0),(3,NULL)) s(i,lat) LEFT JOIN LATERAL nws.compat.climate_outlook_at(s.lat,-78,'{"period":"seasonal","lead":13}') o ON true GROUP BY s.i ORDER BY s.i;
----
1	2
2	2
3	0

# extensions-compat-fire_outlook_at
query II
SELECT s.i, count(o.object_id) FROM (VALUES(1,38.0),(2,38.0),(3,NULL)) s(i,lat) LEFT JOIN LATERAL nws.compat.fire_outlook_at(s.lat,-78,'{"day":8,"hazard":"dry_thunderstorm"}') o ON true GROUP BY s.i ORDER BY s.i;
----
1	2
2	2
3	0

# extensions-compat-qpe
query IR
SELECT count(*), sum(o.precipitation) FROM (VALUES(38.0),(38.0),(NULL)) s(lat), LATERAL nws.compat.precipitation_observed_at(s.lat,-78,'{"period":"day7"}') o;
----
2	2.5

# extensions-compat-rating
query II
SELECT count(*), bool_and(possibly_truncated) FROM (VALUES('RMDV2'),('RMDV2'),(NULL)) s(id), LATERAL nws.compat.rating_curve(s.id,'{"row_limit":1,"sort":"DESC"}') r;
----
2	1

# extensions-compat-streamflow
query II
SELECT count(*), count(DISTINCT member) FROM (VALUES('23021904'),('23021904'),(NULL)) s(id), LATERAL nws.compat.reach_streamflow(s.id,'{"series":"long_range"}') r;
----
12	3

# extensions-batch-winter
query I
SELECT count(*) FROM range(40) t(i), LATERAL nws.compat.winter_precipitation_at(38+i*0.001,-78,'{"page_size":1}') o;
----
80

# extensions-batch-qpe
query III
SELECT count(*), sum(o.precipitation), count(DISTINCT o.latitude) FROM range(40) t(i), LATERAL nws.main.precipitation_observed_at(38+i*0.001,-78) o;
----
40	50	40

# extensions-batch-model
query I
SELECT count(*) FROM (SELECT CASE WHEN i%2=0 THEN '23021904' ELSE NULL END AS reach_id FROM range(40) t(i)) s, LATERAL nws.main.reach_streamflow(s.reach_id) o;
----
40

