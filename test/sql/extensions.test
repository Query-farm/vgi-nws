# name: test/sql/extensions.test
# description: Extended NWS outlooks, raster QPE and river products
# group: [nws]
require vgi

require-env NWS_WORKER

statement ok
ATTACH 'nws' (TYPE vgi, LOCATION '{NWS_WORKER}');

# extensions-fire-probabilities
query RII
SELECT category_code, probability_pct, issued_at = TIMESTAMPTZ '2026-01-01 19:30:00+00' FROM nws.main.fire_outlook(day := 3) ORDER BY object_id;
----
0.4	40	1
0.7	70	1
0	NULL	1

# extensions-fire-3-wind_rh
query II
SELECT count(*), count(probability_pct) FROM nws.main.fire_outlook(day := 3, hazard := 'wind_rh', page_size := 1);
----
3	2

# extensions-fire-3-dry_thunderstorm
query II
