# extensions-monthly-temperature
query TITIII
SELECT category, probability_pct, target_period, valid_from IS NULL, valid_to IS NULL, lead IS NULL FROM nws.main.climate_outlook(period := 'monthly',variable := 'temperature') ORDER BY object_id;
----
Above	40	Feb 2026	1	1	1
Below	50	Feb 2026	1	1	1
EC	33	Feb 2026	1	1	1

# extensions-seasonal-temperature-1
query III
SELECT count(*), min(lead), bool_and(target_period = 'NDJ 2026-2027 (Lead 1)') FROM nws.main.climate_outlook(period := 'seasonal',variable := 'temperature',lead := 1);
----
3	1	1

